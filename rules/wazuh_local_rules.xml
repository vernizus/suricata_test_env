<!--
  Wazuh Custom Rules — Suricata Local Test Rules
  ================================================
  These rules match alerts generated by rules/local.rules (SID 9000001–9000099).
  They are child rules of Wazuh's built-in Suricata alert rule (group: suricata).

  INSTALLATION (Wazuh Manager):
    Copy to: /var/ossec/etc/rules/local_suricata_rules.xml
    Then restart: systemctl restart wazuh-manager
       or reload:  /var/ossec/bin/wazuh-control restart

  VERIFY loaded rules:
    /var/ossec/bin/ossec-logtest < /dev/null

  Rule ID range: 100001–100099 (adjust if they conflict with existing custom rules)

  Wazuh alert levels:
    0–4   Informational / low
    5–7   Medium
    8–11  High
    12–15 Critical
-->

<group name="suricata,local_ids,">

  <!-- ══════════════════════════════════════════════════════════
       PARENT — any LOCAL rule (all our rules have [LOCAL] prefix)
       Matches before the more specific child rules below
       ══════════════════════════════════════════════════════════ -->
  <rule id="100000" level="3">
    <if_group>suricata</if_group>
    <field name="alert.signature" type="pcre2">\[LOCAL\]</field>
    <description>Suricata [LOCAL]: $(alert.signature)</description>
    <group>local_ids,</group>
  </rule>


  <!-- ══════════════════════════════════════════════════════════
       ICMP  (SID 9000001–9000002)
       ══════════════════════════════════════════════════════════ -->
  <rule id="100001" level="3">
    <if_sid>100000</if_sid>
    <field name="alert.signature_id" type="pcre2">^9000001$</field>
    <description>Suricata [LOCAL]: ICMP Echo Request (ping) from $(src_ip)</description>
    <group>icmp,</group>
  </rule>

  <rule id="100002" level="3">
    <if_sid>100000</if_sid>
    <field name="alert.signature_id" type="pcre2">^9000002$</field>
    <description>Suricata [LOCAL]: ICMP Echo Reply to $(dest_ip)</description>
    <group>icmp,</group>
  </rule>


  <!-- ══════════════════════════════════════════════════════════
       HTTP — Test server requests  (SID 9000010–9000013)
       ══════════════════════════════════════════════════════════ -->
  <rule id="100010" level="3">
    <if_sid>100000</if_sid>
    <field name="alert.signature_id" type="pcre2">^9000010$</field>
    <description>Suricata [LOCAL]: HTTP request to test server :8080 from $(src_ip)</description>
    <group>web,</group>
  </rule>

  <rule id="100011" level="6">
    <if_sid>100000</if_sid>
    <field name="alert.signature_id" type="pcre2">^900001[123]$</field>
    <description>Suricata [LOCAL]: HTTP error response from test server - $(alert.signature)</description>
    <group>web,http_error,</group>
  </rule>


  <!-- ══════════════════════════════════════════════════════════
       HTTP — Automation tool user agents  (SID 9000020–9000022)
       ══════════════════════════════════════════════════════════ -->
  <rule id="100020" level="4">
    <if_sid>100000</if_sid>
    <field name="alert.signature_id" type="pcre2">^900002[012]$</field>
    <description>Suricata [LOCAL]: Automation tool detected - $(alert.signature) from $(src_ip)</description>
    <group>web,automation,</group>
  </rule>


  <!-- ══════════════════════════════════════════════════════════
       HTTP — Security scanners  (SID 9000023–9000024)
       ══════════════════════════════════════════════════════════ -->
  <rule id="100023" level="8">
    <if_sid>100000</if_sid>
    <field name="alert.signature_id" type="pcre2">^900002[34]$</field>
    <description>Suricata [LOCAL]: Security scanner detected - $(alert.signature) from $(src_ip)</description>
    <group>web,recon,scanner,</group>
    <mitre>
      <id>T1595</id>
    </mitre>
  </rule>


  <!-- ══════════════════════════════════════════════════════════
       HTTP — Web attacks  (SID 9000030–9000033)
       ══════════════════════════════════════════════════════════ -->
  <rule id="100030" level="10">
    <if_sid>100000</if_sid>
    <field name="alert.signature_id" type="pcre2">^900003[0-3]$</field>
    <description>Suricata [LOCAL]: Web attack attempt - $(alert.signature) from $(src_ip)</description>
    <group>web_attack,attack,</group>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <!-- SQL injection — higher severity -->
  <rule id="100031" level="12">
    <if_sid>100030</if_sid>
    <field name="alert.signature_id" type="pcre2">^9000030$</field>
    <description>Suricata [LOCAL]: SQL injection attempt in URI from $(src_ip)</description>
    <group>web_attack,sql_injection,attack,</group>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <!-- XSS attempt -->
  <rule id="100033" level="10">
    <if_sid>100030</if_sid>
    <field name="alert.signature_id" type="pcre2">^9000033$</field>
    <description>Suricata [LOCAL]: XSS attempt in URI from $(src_ip)</description>
    <group>web_attack,xss,attack,</group>
    <mitre>
      <id>T1059.007</id>
    </mitre>
  </rule>


  <!-- ══════════════════════════════════════════════════════════
       TCP — Sensitive service connections  (SID 9000040–9000047)
       ══════════════════════════════════════════════════════════ -->
  <rule id="100040" level="5">
    <if_sid>100000</if_sid>
    <field name="alert.signature_id" type="pcre2">^9000040$</field>
    <description>Suricata [LOCAL]: SSH connection attempt to $(dest_ip) from $(src_ip)</description>
    <group>authentication,remote_access,</group>
    <mitre>
      <id>T1021.004</id>
    </mitre>
  </rule>

  <!-- Telnet — higher severity (cleartext protocol) -->
  <rule id="100041" level="9">
    <if_sid>100000</if_sid>
    <field name="alert.signature_id" type="pcre2">^9000041$</field>
    <description>Suricata [LOCAL]: Telnet connection attempt (cleartext) to $(dest_ip) from $(src_ip)</description>
    <group>authentication,cleartext,policy_violation,</group>
    <mitre>
      <id>T1021</id>
    </mitre>
  </rule>

  <!-- RDP -->
  <rule id="100042" level="6">
    <if_sid>100000</if_sid>
    <field name="alert.signature_id" type="pcre2">^9000042$</field>
    <description>Suricata [LOCAL]: RDP connection attempt to $(dest_ip) from $(src_ip)</description>
    <group>authentication,remote_access,</group>
    <mitre>
      <id>T1021.001</id>
    </mitre>
  </rule>

  <!-- SMB -->
  <rule id="100043" level="6">
    <if_sid>100000</if_sid>
    <field name="alert.signature_id" type="pcre2">^9000043$</field>
    <description>Suricata [LOCAL]: SMB connection attempt to $(dest_ip) from $(src_ip)</description>
    <group>network,lateral_movement,</group>
    <mitre>
      <id>T1021.002</id>
    </mitre>
  </rule>

  <!-- Databases (MySQL, PostgreSQL, Redis, MongoDB) -->
  <rule id="100044" level="6">
    <if_sid>100000</if_sid>
    <field name="alert.signature_id" type="pcre2">^900004[4-7]$</field>
    <description>Suricata [LOCAL]: Database connection attempt - $(alert.signature) from $(src_ip)</description>
    <group>network,database,</group>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>


  <!-- ══════════════════════════════════════════════════════════
       PORT SCANNING  (SID 9000050–9000051)
       ══════════════════════════════════════════════════════════ -->
  <rule id="100050" level="10">
    <if_sid>100000</if_sid>
    <field name="alert.signature_id" type="pcre2">^9000050$</field>
    <description>Suricata [LOCAL]: TCP SYN port scan detected from $(src_ip)</description>
    <group>recon,network_scan,port_scan,</group>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <rule id="100051" level="10">
    <if_sid>100000</if_sid>
    <field name="alert.signature_id" type="pcre2">^9000051$</field>
    <description>Suricata [LOCAL]: UDP port scan detected from $(src_ip)</description>
    <group>recon,network_scan,port_scan,</group>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>


  <!-- ══════════════════════════════════════════════════════════
       DNS — DGA / C2  (SID 9000061)
       ══════════════════════════════════════════════════════════ -->
  <rule id="100061" level="10">
    <if_sid>100000</if_sid>
    <field name="alert.signature_id" type="pcre2">^9000061$</field>
    <description>Suricata [LOCAL]: Suspicious DNS query - possible DGA/C2 beacon from $(src_ip)</description>
    <group>dns,c2,malware,</group>
    <mitre>
      <id>T1568.002</id>
    </mitre>
  </rule>


  <!-- ══════════════════════════════════════════════════════════
       TLS — Non-standard port  (SID 9000070)
       ══════════════════════════════════════════════════════════ -->
  <rule id="100070" level="10">
    <if_sid>100000</if_sid>
    <field name="alert.signature_id" type="pcre2">^9000070$</field>
    <description>Suricata [LOCAL]: TLS on non-standard port - possible C2 from $(src_ip) to $(dest_ip):$(dest_port)</description>
    <group>tls,c2,suspicious,</group>
    <mitre>
      <id>T1571</id>
    </mitre>
  </rule>


  <!-- ══════════════════════════════════════════════════════════
       BRUTE FORCE  (SID 9000080–9000081)
       ══════════════════════════════════════════════════════════ -->
  <rule id="100080" level="12">
    <if_sid>100000</if_sid>
    <field name="alert.signature_id" type="pcre2">^9000080$</field>
    <description>Suricata [LOCAL]: HTTP brute force detected - multiple 401 responses to $(dest_ip)</description>
    <group>authentication_failed,brute_force,attack,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100081" level="11">
    <if_sid>100000</if_sid>
    <field name="alert.signature_id" type="pcre2">^9000081$</field>
    <description>Suricata [LOCAL]: Resource enumeration - multiple 403 responses to $(dest_ip)</description>
    <group>recon,web,enumeration,</group>
    <mitre>
      <id>T1595.003</id>
    </mitre>
  </rule>

</group>
